# ============================================================
#  环境变量模板 —— 复制为 .env 后填入你自己的 key
#  cp .env.example .env
#  .env 已被 .gitignore 忽略，不会进 Git
# ============================================================
#
# 各 key 申请入口：
#   ARK_API_KEY:       https://console.volcengine.com/ark/   (火山方舟 / 豆包大模型，AI 搜索主链路必填)
#   DEEPSEEK_API_KEY:  https://platform.deepseek.com/         (可选，仅多模型对比评测用)
#   AMAP_WEB_KEY:      https://console.amap.com/              (高德地图 Web 服务 / JS API，地图与地理编码必填)

# ---- Provider 选择 ----
SEARCH_PROVIDER=ark_seed
LLM_PROVIDER=ark_seed

# ---- 火山方舟 Ark / 豆包（AI 联网搜索 + 内容整理，必填）----
ARK_API_KEY=your-ark-api-key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_MODEL=doubao-seed-2-0-mini-260428

# ---- DeepSeek（可选，仅用于多模型对比评测）----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 高德地图（前端地图渲染 + 后端地理编码都要用，必填）----
# AMAP_WEB_KEY: 后端 geocode 用的 Web 服务 key
# AMAP_JS_KEY / AMAP_JS_SECURITY_CODE: 前端地图 JS API 用
AMAP_WEB_KEY=your-amap-web-key
AMAP_JS_KEY=your-amap-js-key
AMAP_JS_SECURITY_CODE=your-amap-security-code

# ---- 前端注入：高德 JS key（Taro 编译期读取）----
# docker-compose 默认会回退用 AMAP_WEB_KEY / AMAP_JS_KEY，单独部署前端时按需填
TARO_APP_AMAP_WEB_KEY=your-amap-js-key
TARO_APP_AMAP_SECURITY_CODE=your-amap-security-code

# ---- CORS 白名单（生产部署改成你的真实 H5 域名，逗号分隔）----
# 例：CORS_ALLOW_ORIGINS=https://your-h5-domain.com
# 留空时后端回退到本地默认白名单（localhost:10086）
CORS_ALLOW_ORIGINS=http://localhost:10086,http://127.0.0.1:10086

# ---- 前端连后端的地址（Taro 编译期注入）----
# 用 docker-compose 时无需改（compose 内部已设为 http://api:8000）
# 单独部署 / 小程序构建：填「已 ICP 备案的 HTTPS 域名」——微信小程序禁止请求 localhost/IP
# 例：TARO_APP_API_BASE=https://api.your-domain.com
TARO_APP_API_BASE=http://127.0.0.1:8000
